[Unit]
Description=Hub API (library, resume, browse, best stream)
PartOf=hub.target

[Container]
Image=ghcr.io/thefactor1/mediabox-hub:latest
GlobalArgs=--storage-opt=additionalimagestore=/usr/lib/bootc/storage
Network=host
Volume=/var/lib/hub:/var/lib/hub:Z

[Service]
Restart=on-failure

[Install]
WantedBy=hub.target
