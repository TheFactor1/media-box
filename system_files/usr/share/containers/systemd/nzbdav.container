[Unit]
Description=nzbdav
PartOf=hub.target

[Container]
Image=docker.io/nzbdav/nzbdav:alpha
Pull=never
Network=host
Environment=PUID=1000 PGID=1000 TZ=Etc/UTC
Volume=/var/lib/nzbdav:/config:Z
Volume=/media:/media:rslave
Volume=/mnt:/mnt:rslave

[Service]
Restart=on-failure

[Install]
WantedBy=hub.target
