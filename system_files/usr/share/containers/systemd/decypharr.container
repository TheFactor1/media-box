[Unit]
Description=decypharr
PartOf=hub.target

[Container]
Image=ghcr.io/sirrobot01/decypharr:latest
GlobalArgs=--storage-opt=additionalimagestore=/usr/lib/bootc/storage
Network=host
Environment=PUID=1000 PGID=1000 TZ=Etc/UTC
Volume=/var/lib/decypharr:/app:Z
Volume=/media:/media:rslave
Volume=/mnt:/mnt:rslave

[Service]
Restart=on-failure

[Install]
WantedBy=hub.target
