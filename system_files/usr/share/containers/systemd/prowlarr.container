[Unit]
Description=prowlarr
PartOf=hub.target
After=mnt-debrid.service mnt-usenet.service

[Container]
Image=lscr.io/linuxserver/prowlarr:latest
Pull=never
Network=host
Environment=PUID=1000 PGID=1000 TZ=Etc/UTC
Volume=/var/lib/prowlarr:/config:Z
Volume=/media:/media:rslave
Volume=/mnt:/mnt:rslave

[Service]
Restart=on-failure

[Install]
WantedBy=hub.target
