[Unit]
Description=TV interface (Broadsheet, in a kiosk browser)
Requires=mediabox-shell.service
After=mediabox-shell.service systemd-user-sessions.service sound.target
Conflicts=getty@tty1.service kodi.service mediabox-mpv.service

[Service]
User=media
Group=media
SupplementaryGroups=audio video render input
# A logind session on tty1 gives the compositor the display and input, as Kodi gets them.
PAMName=login
TTYPath=/dev/tty1
StandardInput=tty
StandardOutput=journal
StandardError=journal
StateDirectory=media
Environment=HOME=/var/lib/media
ExecStart=/usr/libexec/mediabox/ui-session
Restart=on-failure
RestartSec=2
