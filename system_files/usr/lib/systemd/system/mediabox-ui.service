[Unit]
Description=TV interface (Broadsheet, in a kiosk browser)
Requires=mediabox-shell.service
After=mediabox-shell.service systemd-user-sessions.service sound.target
Conflicts=getty@tty1.service kodi.service

[Service]
User=media
Group=media
SupplementaryGroups=audio video render input
# A logind session on tty1 gives the compositor the display and input, as Kodi gets them.
PAMName=login
TTYPath=/dev/tty1
StandardInput=tty
StandardOutput=journal
StandardError=journal
TTYReset=yes
TTYVTDisallocate=yes
StateDirectory=media
Environment=HOME=/var/lib/media
# Between the film and the interface the screen is the text console: keep it blank.
ExecStartPre=-/usr/bin/sh -c 'printf "\\033[2J\\033[H\\033[?25l" > /dev/tty1'
ExecStart=/usr/libexec/mediabox/ui-session
ExecStopPost=-/usr/bin/sh -c 'printf "\\033[2J\\033[H\\033[?25l" > /dev/tty1'
Restart=on-failure
RestartSec=2

[Install]
WantedBy=multi-user.target
