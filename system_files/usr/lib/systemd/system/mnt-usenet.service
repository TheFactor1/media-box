[Unit]
Description=rclone mount of NzbDAV WebDAV at /mnt/usenet
PartOf=hub.target
After=nzbdav.service
Requires=nzbdav.service
ConditionPathExists=/var/lib/mediabox/rclone.conf

[Service]
User=media
Group=media
ExecStart=/usr/bin/rclone mount usenet: /mnt/usenet \
  --config /var/lib/mediabox/rclone.conf \
  --read-only --allow-other \
  --vfs-cache-mode off --dir-cache-time 10s --poll-interval 0 \
  --buffer-size 64M --vfs-read-chunk-size 32M --vfs-read-chunk-size-limit 1G
ExecStop=/usr/bin/fusermount3 -uz /mnt/usenet
Restart=on-failure
RestartSec=5

[Install]
WantedBy=hub.target
