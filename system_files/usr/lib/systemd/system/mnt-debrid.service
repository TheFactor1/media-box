[Unit]
Description=rclone mount of Decypharr WebDAV at /mnt/debrid
PartOf=hub.target
After=decypharr.service
Requires=decypharr.service
# The wizard writes the remote definition here; without it the mount stays down.
ConditionPathExists=/var/lib/mediabox/rclone.conf

[Service]
User=media
Group=media
ExecStart=/usr/bin/rclone mount debrid: /mnt/debrid \
  --config /var/lib/mediabox/rclone.conf \
  --read-only --allow-other \
  --vfs-cache-mode off --dir-cache-time 10s --poll-interval 0 \
  --buffer-size 64M --vfs-read-chunk-size 32M --vfs-read-chunk-size-limit 1G
ExecStop=/usr/bin/fusermount3 -uz /mnt/debrid
Restart=on-failure
RestartSec=5

[Install]
WantedBy=hub.target
