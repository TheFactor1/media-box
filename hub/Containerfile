# On a tag, not a digest, on purpose: the weekly hub.yml rebuild must pick up Alpine and Python fixes.
FROM docker.io/library/python:3.12-alpine
WORKDIR /app
COPY --chown=1001:1000 . /app/hub/
# uid 1001 = hub, gid 1000 = media: Kodi (media) may read the token, never the key (DATAFLOW.md).
USER 1001:1000
ENV HUB_CONFIG=/var/lib/hub/hub.toml HUB_DATA=/var/lib/hub PYTHONUNBUFFERED=1
EXPOSE 8097
CMD ["python", "-m", "hub.hub"]
